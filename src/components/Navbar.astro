---
const navLinks = [
  { label: 'Servicios', href: '#servicios' },
  { label: 'Nosotros', href: '#equipo' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-warm-50/95 backdrop-blur-sm border-b border-warm-200 shadow-sm"
  role="banner"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2.5 group"
        aria-label="Saint Michelle Clínica Psiquiátrica — Ir al inicio"
      >
        <!-- Logomark SVG -->
        <div class="w-9 h-9 rounded-xl bg-sage-100 flex items-center justify-center group-hover:bg-sage-200 transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5 text-sage-600"
            aria-hidden="true"
          >
            <!-- Leaf / growth icon -->
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
          </svg>
        </div>
        <div class="leading-tight">
          <span class="block text-base font-semibold text-slate-800 tracking-tight">
            Saint Michelle
          </span>
          <span class="block text-[11px] font-medium text-sage-600 tracking-wide uppercase">
            Clínica Psiquiátrica
          </span>
        </div>
      </a>

      <!-- Desktop navigation -->
      <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-600 hover:text-sage-600 transition-colors relative after:absolute after:-bottom-0.5 after:left-0 after:w-0 after:h-px after:bg-sage-400 hover:after:w-full after:transition-all"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile toggle -->
      <div class="flex items-center gap-3">
        <a
          href="#contacto"
          class="hidden md:inline-flex items-center gap-1.5 bg-sage-600 hover:bg-sage-700 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors shadow-sm hover:shadow-md"
          aria-label="Agendar turno en Saint Michelle"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
            <line x1="16" x2="16" y1="2" y2="6" />
            <line x1="8" x2="8" y1="2" y2="6" />
            <line x1="3" x2="21" y1="10" y2="10" />
            <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" />
          </svg>
          Agendar Turno
        </a>

        <!-- Mobile hamburger button -->
        <button
          id="nav-hamburger"
          type="button"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg text-slate-600 hover:bg-warm-100 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
        >
          <!-- Hamburger icon (shown by default) -->
          <svg
            id="icon-hamburger"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="w-5 h-5"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="6" y2="6" />
            <line x1="4" x2="20" y1="12" y2="12" />
            <line x1="4" x2="20" y1="18" y2="18" />
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="w-5 h-5 hidden"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu (collapsed by default) -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-warm-200 bg-warm-50"
    role="navigation"
    aria-label="Navegación móvil"
  >
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-slate-700 hover:text-sage-600 hover:bg-sage-50 px-3 py-2.5 rounded-lg transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#contacto"
        class="mt-2 flex items-center justify-center gap-1.5 bg-sage-600 hover:bg-sage-700 text-white text-sm font-semibold px-5 py-3 rounded-full transition-colors"
        aria-label="Agendar turno"
      >
        Agendar Turno
      </a>
    </div>
  </div>
</header>

<!-- Spacer to prevent content hiding behind fixed header -->
<div class="h-16 md:h-20" aria-hidden="true"></div>

<script>
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose = document.getElementById('icon-close');

  hamburger?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');

    mobileMenu?.classList.toggle('hidden');
    iconHamburger?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    hamburger.setAttribute(
      'aria-label',
      isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación'
    );
  });

  // Close mobile menu when a link is clicked
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      iconHamburger?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      hamburger?.setAttribute('aria-expanded', 'false');
      hamburger?.setAttribute('aria-label', 'Abrir menú de navegación');
    });
  });
</script>
