---
---

<section
  id="inicio"
  aria-labelledby="hero-heading"
  class="relative overflow-hidden bg-warm-50 pt-10 pb-16 md:pt-16 md:pb-24"
>
  <!-- Soft decorative background blobs -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 -left-24 w-96 h-96 rounded-full bg-sage-100/60 blur-3xl"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 -right-24 w-80 h-80 rounded-full bg-cerulean-100/50 blur-3xl"
  ></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Text content -->
      <div class="order-2 lg:order-1">
        <!-- Eyebrow badge -->
        <div class="inline-flex items-center gap-2 bg-sage-100 text-sage-700 text-xs font-semibold px-3 py-1.5 rounded-full mb-6 tracking-wide uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-sage-500 shrink-0" aria-hidden="true"></span>
          Atención Psiquiátrica de Primer Nivel
        </div>

        <h1
          id="hero-heading"
          class="text-4xl sm:text-5xl lg:text-[3.25rem] font-bold text-slate-800 leading-tight tracking-tight mb-5"
        >
          Tu bienestar mental<br class="hidden sm:block" />
          en manos de <span class="text-sage-600">expertos</span>
        </h1>

        <p class="text-lg text-slate-500 leading-relaxed mb-8 max-w-lg">
          Acompañamos cada etapa de tu proceso con un enfoque humano, riguroso y sin juicios.
          Profesionales matriculados, actualización permanente y un espacio seguro para sanar.
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="#contacto"
            class="inline-flex items-center justify-center gap-2 bg-sage-600 hover:bg-sage-700 text-white font-semibold px-7 py-3.5 rounded-full transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
            aria-label="Agendar turno en Saint Michelle Clínica Psiquiátrica"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 shrink-0"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
              <line x1="16" x2="16" y1="2" y2="6" />
              <line x1="8" x2="8" y1="2" y2="6" />
              <line x1="3" x2="21" y1="10" y2="10" />
              <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" />
            </svg>
            Agendar Turno
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-warm-100 text-slate-700 font-semibold px-7 py-3.5 rounded-full border border-warm-200 transition-all hover:-translate-y-0.5"
            aria-label="Ver todos nuestros servicios"
          >
            Ver servicios
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 shrink-0"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Trust micro-indicators -->
        <div class="mt-10 flex flex-wrap gap-5" role="list" aria-label="Datos de confianza">
          <div role="listitem" class="flex items-center gap-2 text-sm text-slate-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 text-sage-500 shrink-0"
              aria-hidden="true"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
            </svg>
            Profesionales matriculados
          </div>
          <div role="listitem" class="flex items-center gap-2 text-sm text-slate-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 text-sage-500 shrink-0"
              aria-hidden="true"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <path d="m9 11 3 3L22 4" />
            </svg>
            Primera consulta confidencial
          </div>
          <div role="listitem" class="flex items-center gap-2 text-sm text-slate-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 text-sage-500 shrink-0"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            Turnos en 48 hs
          </div>
        </div>
      </div>

      <!-- Hero image -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-lg">
          <div
            aria-hidden="true"
            class="absolute -inset-3 rounded-3xl bg-linear-to-br from-sage-100 to-cerulean-100 opacity-70"
          ></div>
          <img
            src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?w=760&h=640&fit=crop&q=80"
            alt="Consultorio de la Clínica Psiquiátrica Saint Michelle — un espacio cálido, seguro y acogedor para tu bienestar mental"
            width="760"
            height="640"
            loading="eager"
            decoding="async"
            class="relative w-full h-auto rounded-2xl shadow-xl object-cover aspect-4/3"
          />
          <!-- Floating badge -->
          <div
            class="absolute -bottom-4 -left-4 bg-white rounded-2xl shadow-lg px-4 py-3 flex items-center gap-3 border border-warm-200"
            aria-hidden="true"
          >
            <div class="w-10 h-10 rounded-xl bg-cerulean-100 flex items-center justify-center shrink-0">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-cerulean-600"
              >
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-slate-800 leading-none mb-0.5">+1.200 pacientes</p>
              <p class="text-xs text-slate-400">acompañados con éxito</p>
            </div>
          </div>
          <!-- Floating years badge -->
          <div
            class="absolute -top-4 -right-4 bg-sage-600 text-white rounded-2xl shadow-lg px-4 py-3 text-center"
            aria-hidden="true"
          >
            <p class="text-2xl font-bold leading-none">+15</p>
            <p class="text-[11px] font-medium opacity-90">años de</p>
            <p class="text-[11px] font-medium opacity-90">experiencia</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
